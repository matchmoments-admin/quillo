{
  "name": "tax-agent",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy && npm run rulepack:push && npm run security:push-docs",
    "schema": "wrangler d1 execute tax-agent-db --file=schema.sql",
    "schema:local": "wrangler d1 execute tax-agent-db --local --file=schema.sql",
    "eval": "promptfoo eval -c evals/promptfooconfig.yaml --output evals/results.json --no-write",
    "eval:view": "promptfoo view",
    "eval:gate": "node scripts/check-eval-baseline.mjs",
    "eval:ci": "npm run eval; node scripts/check-eval-baseline.mjs",
    "eval:export": "node scripts/export-evals.mjs",
    "eval:statements": "tsx scripts/check-statements.ts",
    "test:units": "tsx scripts/check-units.ts",
    "test:personas": "tsx scripts/check-personas.ts",
    "test:e2e": "tsx scripts/e2e-journey.ts",
    "test:au-snapshot": "tsx scripts/check-au-snapshot.ts",
    "test:schema": "tsx scripts/check-schema-drift.ts",
    "test": "npm run test:units && npm run test:shell && npm run test:colors && npm run test:theme && npm run test:personas && npm run test:e2e && npm run test:au-snapshot && npm run eval:statements && npm run test:schema",
    "rulepack:push": "node scripts/push-rulepack.mjs src/rulepacks/au-v1.json",
    "security:push-docs": "tsx scripts/push-security-docs.ts",
    "onboard": "node scripts/onboard.mjs",
    "preflight": "node scripts/preflight.mjs",
    "web:install": "cd web && npm install",
    "web:build": "cd web && npm run build",
    "web:dev": "cd web && npm run dev",
    "test:shell": "tsx scripts/check-mobile-shell.ts",
    "test:colors": "tsx scripts/check-no-raw-colors.ts",
    "test:theme": "tsx scripts/check-theme-contrast.ts",
    "sim:shell": "node scripts/sim-mobile-shell.mjs",
    "sim:shell:control": "node scripts/sim-mobile-shell.mjs --legacy"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.34.2",
    "@anthropic-ai/sdk": "^0.131.0",
    "@cantoo/pdf-lib": "^2.11.1",
    "agents": "^0.26.0",
    "fflate": "^0.8.3",
    "jose": "^5.9.6",
    "postal-mime": "^2.4.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261008.1",
    "promptfoo": "^0.124.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "wrangler": "^4.148.0"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  }
}
